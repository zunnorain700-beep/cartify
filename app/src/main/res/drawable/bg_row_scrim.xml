<?xml version="1.0" encoding="utf-8"?>
<!-- Barely-there wash over each row's blurred artwork: enough to keep white titles
     legible, light enough that the song's own colours still read through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="#3D040A06"
        android:endColor="#59040A06"
        android:startColor="#26040A06"
        android:type="linear" />
    <corners android:radius="22dp" />
</shape>
